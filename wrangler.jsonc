{
  // ATENCIÓN: este nombre tiene que ser EXACTAMENTE el de tu Worker actual.
  // Si no coincide, wrangler crea otro distinto y tu dominio sigue apuntando al
  // viejo, así que no verías ningún cambio. Para comprobarlo:
  //   npx wrangler deployments list
  // o mira la URL que te da Cloudflare, del tipo <nombre>.<algo>.workers.dev
  "name": "web-hasq",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-12",

  // Valores que NO son secretos, así que viven aquí y sobreviven a cualquier
  // despliegue. no hace falta que la dirección exista: Resend deja enviar desde
  // cualquier dirección de un dominio verificado. Los dos secretos
  // (RESEND_API_KEY y TURNSTILE_SECRET) van en el panel, nunca en el repositorio.
  "vars": {
    "CONTACT_FROM": "Portafolio <contacto@hasq.dev>",
    "CONTACT_TO": "ha.solis.q@gmail.com"
  },

  // El sitio se sirve tal cual está en el repositorio, sin build.
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    // Que las rutas no encontradas devuelvan tu 404.html en vez de un 404 vacío.
    "not_found_handling": "404-page",
    // La API se atiende antes de mirar si hay un archivo con ese nombre.
    "run_worker_first": ["/api/*"]
  }
}
